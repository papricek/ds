<%= form_with(model: @user, url: url, class: "Form Form--dark") do |f| %>
  <div class="row">
    <div class="col-md-6">
      <div class="Form__group">
        <%= f.label :name, t("users.name"), class: "Form__label Form__label--required" %>
        <%= f.text_field :name, class: "Form__input form-control #{error_class_for(@user, :name)}" %>
        <%= error_message_for(@user, :name) %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="Form__group">
        <%= f.label :email, t("users.email"), class: "Form__label Form__label--required" %>
        <%= f.email_field :email, class: "Form__input form-control #{error_class_for(@user, :email)}" %>
        <%= error_message_for(@user, :email) %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="Form__group">
        <%= f.label :phone, t("users.phone"), class: "Form__label" %>
        <%= f.text_field :phone, class: "Form__input form-control #{error_class_for(@user, :phone)}" %>
        <%= error_message_for(@user, :phone) %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="Form__group">
        <%= f.label :role, t("users.role"), class: "Form__label" %>
        <%= f.select :role, [
          [t("users.roles.user"), "user"],
          [t("users.roles.manager"), "manager"]
        ], {}, class: "Form__input form-select" %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="Form__group">
        <%= f.label :password, t("users.password"), class: "Form__label #{'Form__label--required' if @user.new_record?}" %>
        <%= f.password_field :password, class: "Form__input form-control #{error_class_for(@user, :password)}", autocomplete: "new-password" %>
        <%= error_message_for(@user, :password) %>
        <% unless @user.new_record? %>
          <small style="color: var(--white-5);"><%= t("users.leave_blank_to_keep") %></small>
        <% end %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="Form__group">
        <%= f.label :password_confirmation, t("users.password_confirmation"), class: "Form__label #{'Form__label--required' if @user.new_record?}" %>
        <%= f.password_field :password_confirmation, class: "Form__input form-control", autocomplete: "new-password" %>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2 mt-3">
    <%= f.submit @user.new_record? ? t("common.create") : t("common.save"), class: "Button Button--primary", data: { disable_with: disable_with } %>
    <%= link_to t("common.cancel"), superadmin_account_path(@account), class: "Button Button--secondary" %>
  </div>
<% end %>
