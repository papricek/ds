<%= form_with(model: [:superadmin, @account], url: url, class: "Form Form--dark") do |f| %>
  <div class="row">
    <div class="col-md-6">
      <div class="form-floating Form__group">
        <%= f.text_field :name, class: "form-control Form__input #{error_class_for(@account, :name)}", placeholder: t("superadmin.accounts.name") %>
        <%= f.label :name, t("superadmin.accounts.name"), class: "Form__label Form__label--required" %>
        <%= error_message_for(@account, :name) %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-floating Form__group">
        <%= f.text_field :subdomain, class: "form-control Form__input #{error_class_for(@account, :subdomain)}", placeholder: t("superadmin.accounts.subdomain") %>
        <%= f.label :subdomain, t("superadmin.accounts.subdomain"), class: "Form__label" %>
        <%= error_message_for(@account, :subdomain) %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="form-floating Form__group">
        <%= f.select :plan, [
          [t("superadmin.accounts.plans.light"), "light"],
          [t("superadmin.accounts.plans.full"), "full"]
        ], {}, class: "form-select Form__input" %>
        <%= f.label :plan, t("superadmin.accounts.plan"), class: "Form__label" %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="Form__group">
        <%= f.label :logo, t("settings.logo"), class: "Form__label" %>
        <%= f.file_field :logo, class: "form-control Form__input" %>
      </div>
    </div>
  </div>

  <div class="Form__actions">
    <%= link_to t("common.cancel"), superadmin_accounts_path, class: "Form__btn-link" %>
    <%= f.submit @account.new_record? ? t("common.create") : t("common.save"), class: "Form__btn", data: { disable_with: disable_with } %>
  </div>
<% end %>
