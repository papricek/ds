<% content_for :title, @account.name %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="text-white mb-0"><%= @account.name %></h1>
  <div class="d-flex gap-2">
    <%= link_to edit_superadmin_account_path(@account), class: "Button Button--secondary" do %>
      <i class="fas fa-pen me-1"></i> <%= t("common.edit") %>
    <% end %>
    <%= link_to superadmin_accounts_path, class: "Button Button--secondary" do %>
      <i class="fas fa-arrow-left me-1"></i> <%= t("common.back") %>
    <% end %>
  </div>
</div>

<div class="row">
  <div class="col-lg-6 mb-4">
    <div class="Card">
      <div class="Card__title"><%= t("superadmin.accounts.details") %></div>
      <div class="Box">
        <div class="Box__items">
          <div class="Box__item">
            <div class="Box__item-icon"><i class="fas fa-building"></i></div>
            <div class="Box__item-main">
              <div class="Box__item-label"><%= t("superadmin.accounts.name") %></div>
              <div class="Box__item-value"><%= @account.name %></div>
            </div>
          </div>
          <div class="Box__item">
            <div class="Box__item-icon"><i class="fas fa-globe"></i></div>
            <div class="Box__item-main">
              <div class="Box__item-label"><%= t("superadmin.accounts.subdomain") %></div>
              <div class="Box__item-value"><%= @account.subdomain.presence || "—" %></div>
            </div>
          </div>
          <div class="Box__item">
            <div class="Box__item-icon"><i class="fas fa-tag"></i></div>
            <div class="Box__item-main">
              <div class="Box__item-label"><%= t("superadmin.accounts.plan") %></div>
              <div class="Box__item-value">
                <span class="Badge Badge--<%= @account.light? ? 'neutral' : 'info' %>">
                  <%= t("superadmin.accounts.plans.#{@account.plan || 'light'}") %>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-6 mb-4">
    <div class="Card">
      <div class="d-flex justify-content-between align-items-center">
        <div class="Card__title"><%= t("superadmin.accounts.users_count") %> (<%= @users.count %>)</div>
        <%= link_to new_superadmin_account_user_path(@account), class: "Button Button--primary Button--small" do %>
          <i class="fas fa-plus me-1"></i> <%= t("common.create") %>
        <% end %>
      </div>
      <% if @users.any? %>
        <div class="Table Table--small">
          <table>
            <thead>
              <tr>
                <th><%= t("users.name") %></th>
                <th><%= t("users.email") %></th>
                <th><%= t("users.role") %></th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @users.each do |user| %>
                <tr>
                  <td><%= user.name %></td>
                  <td><%= copyable_field(user.email) %></td>
                  <td>
                    <span class="Badge Badge--<%= user.manager? ? 'info' : 'neutral' %> Badge--small">
                      <%= t("users.roles.#{user.role}") %>
                    </span>
                  </td>
                  <td class="text-end">
                    <%= link_to edit_superadmin_account_user_path(@account, user), class: "Button Button--edit Button--small" do %>
                      <i class="fas fa-pen"></i>
                    <% end %>
                    <%= link_to superadmin_account_user_path(@account, user), data: { turbo_method: :delete, turbo_confirm: t("common.confirm_delete") }, class: "Button Button--destroy Button--small" do %>
                      <i class="fas fa-trash"></i>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% if @addresses.any? %>
  <div class="row">
    <div class="col-12 mb-4">
      <div class="Card">
        <div class="Card__title"><%= t("superadmin.accounts.addresses_count") %> (<%= @account.addresses.count %>)</div>
        <div class="Table Table--small">
          <table>
            <thead>
              <tr>
                <th><%= t("addresses.ean") %></th>
                <th><%= t("addresses.role") %></th>
                <th><%= t("addresses.city") %></th>
                <th><%= t("users.name") %></th>
              </tr>
            </thead>
            <tbody>
              <% @addresses.each do |address| %>
                <tr>
                  <td><%= copyable_field(address.ean) %></td>
                  <td>
                    <span class="Badge Badge--<%= address.customer? ? 'consumption' : 'production' %> Badge--small">
                      <%= t("addresses.roles.#{address.role}") %>
                    </span>
                  </td>
                  <td><%= address.city %></td>
                  <td><%= address.user&.name %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
<% end %>
