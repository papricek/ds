<button class="App__nav-toggle d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#appOffcanvas">
  <i class="fas fa-bars"></i>
</button>

<div class="App__nav-wrapper d-none d-lg-flex">
  <nav class="Nav">
    <ul class="Nav__list">
      <li class="Nav__item">
        <%= link_to dashboards_path, class: "Nav__link #{active_if('dashboards')}" do %>
          <i class="fas fa-chart-line me-2"></i>
          <%= t("navigation.dashboard") %>
        <% end %>
      </li>
      <% unless Current.user.manager_or_superadmin? %>
        <li class="Nav__item">
          <%= link_to sharings_path, class: "Nav__link #{'active' if controller_path == 'sharings'}" do %>
            <i class="fas fa-share-nodes me-2"></i>
            <%= t("navigation.sharings") %>
          <% end %>
        </li>
        <li class="Nav__item">
          <%= link_to billings_path, class: "Nav__link #{'active' if controller_path == 'billings'}" do %>
            <i class="fas fa-file-invoice me-2"></i>
            <%= t("navigation.billings") %>
          <% end %>
        </li>
      <% end %>
      <% if Current.user.manager_or_superadmin? %>
        <li class="Nav__item">
          <%= link_to manager_users_path, class: "Nav__link #{'active' if controller_path.start_with?('manager')}" do %>
            <i class="fas fa-shield-halved me-2"></i>
            Admin
          <% end %>
        </li>
      <% end %>
      <% if Current.user.superadmin? %>
        <li class="Nav__item">
          <%= link_to superadmin_accounts_path, class: "Nav__link #{active_if('superadmin')}" do %>
            <i class="fas fa-crown me-2"></i>
            Superadmin
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
</div>

<div class="App__header-user d-none d-lg-block">
  <div class="dropdown">
    <button class="btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false">
      <i class="fas fa-user"></i>
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
      <div class="dropdown-header">
        <div class="dropdown-header__avatar">
          <i class="fas <%= user_icon_class_for_role(Current.user.role) %>"></i>
        </div>
        <div class="dropdown-header__info">
          <div class="dropdown-header__name">
            <%= Current.user.name %>
            <% if Rails.env.development? %>
              <span class="badge bg-secondary"><%= Current.user.id %></span>
            <% end %>
          </div>
          <div class="dropdown-header__role"><%= Current.user.manager? ? t("users.roles.manager") : t("users.roles.user") %></div>
        </div>
      </div>
      <li><hr class="dropdown-divider"></li>
      <li>
        <%= link_to edit_settings_user_path, class: "dropdown-item" do %>
          <i class="fas fa-pen-to-square"></i>
          <%= t("navigation.profile") %>
        <% end %>
      </li>
      <% if Current.user.manager_or_superadmin? %>
        <li>
          <%= link_to edit_manager_settings_path, class: "dropdown-item" do %>
            <i class="fas fa-gear"></i>
            <%= t("navigation.settings") %>
          <% end %>
        </li>
      <% end %>
      <% if Current.user.superadmin? %>
        <li>
          <%= link_to superadmin_accounts_path, class: "dropdown-item" do %>
            <i class="fas fa-crown"></i>
            Superadmin
          <% end %>
        </li>
      <% end %>
      <li><hr class="dropdown-divider"></li>
      <% if impersonated? %>
        <li>
          <%= link_to manager_impersonate_user_path, data: { turbo_method: :delete }, class: "dropdown-item dropdown-item--muted" do %>
            <i class="fas fa-arrow-rotate-left"></i>
            <%= t("manager.impersonate.back") %>
          <% end %>
        </li>
      <% end %>
      <li>
        <%= link_to session_path, data: { turbo_method: :delete }, class: "dropdown-item dropdown-item--muted" do %>
          <i class="fas fa-arrow-right-from-bracket"></i>
          <%= t("sessions.logout") %>
        <% end %>
      </li>
    </ul>
  </div>
</div>

<%= render "layouts/top_mobile" %>
