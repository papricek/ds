<% content_for :title, t("settings.title") %>

<div class="Card">
  <%= form_with(model: @user, url: settings_user_path, method: :patch, class: "Form Form--dark") do |f| %>
    <div class="row">
      <div class="col-md-6">
        <div class="form-floating Form__group">
          <%= f.text_field :name, class: "form-control Form__input #{error_class_for(@user, :name)}", placeholder: t("users.name") %>
          <%= f.label :name, t("users.name"), class: "Form__label Form__label--required" %>
          <%= error_message_for(@user, :name) %>
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-floating Form__group">
          <%= f.email_field :email, class: "form-control Form__input #{error_class_for(@user, :email)}", placeholder: t("users.email") %>
          <%= f.label :email, t("users.email"), class: "Form__label Form__label--required" %>
          <%= error_message_for(@user, :email) %>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form-floating Form__group">
          <%= f.text_field :phone, class: "form-control Form__input", placeholder: t("users.phone") %>
          <%= f.label :phone, t("users.phone"), class: "Form__label" %>
        </div>
      </div>
    </div>

    <div class="Form__actions">
      <%= f.submit t("common.save"), class: "Form__btn", data: { disable_with: disable_with } %>
    </div>
  <% end %>
</div>

<div class="Card mt-4">
  <div class="Card__title"><%= t("settings.change_password") %></div>
  <%= form_with(url: settings_user_path, method: :patch, class: "Form Form--dark") do |f| %>
    <div class="row">
      <div class="col-md-4">
        <div class="form-floating Form__group">
          <%= f.password_field :current_password, class: "form-control Form__input", name: "current_password", placeholder: t("settings.current_password"), autocomplete: "current-password" %>
          <%= f.label :current_password, t("settings.current_password"), class: "Form__label Form__label--required" %>
        </div>
      </div>
      <div class="col-md-4">
        <div class="form-floating Form__group">
          <%= f.password_field :password, class: "form-control Form__input", name: "user[password]", placeholder: t("password_resets.new_password"), autocomplete: "new-password" %>
          <%= f.label :password, t("password_resets.new_password"), class: "Form__label Form__label--required" %>
        </div>
      </div>
      <div class="col-md-4">
        <div class="form-floating Form__group">
          <%= f.password_field :password_confirmation, class: "form-control Form__input", name: "user[password_confirmation]", placeholder: t("password_resets.confirm_password"), autocomplete: "new-password" %>
          <%= f.label :password_confirmation, t("password_resets.confirm_password"), class: "Form__label Form__label--required" %>
        </div>
      </div>
    </div>

    <div class="Form__actions">
      <%= f.submit t("settings.change_password"), class: "Form__btn", data: { disable_with: disable_with } %>
    </div>
  <% end %>
</div>
