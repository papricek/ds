<% content_for :title, t("settings.tabs.profile") %>

<div class="row">
  <div class="col-md-3 mb-3 mb-md-0">
    <%= render "settings/nav" %>
  </div>
  <div class="col-md-9">
    <div class="Box">
      <h1 class="Form__title"><%= t("settings.profile.title") %></h1>
      <p class="Form__text"><%= t("settings.profile.text") %></p>

      <%= form_with(model: @user, url: settings_profile_path, method: :patch, class: "Form Form--dark", html: { novalidate: true }) do |f| %>
        <div class="form-floating Form__group">
          <%= f.text_field :name, class: "form-control Form__input", placeholder: t("users.name") %>
          <%= f.label :name, t("users.name"), class: "Form__label" %>
        </div>

        <div class="form-floating Form__group">
          <%= f.email_field :email, class: "form-control Form__input", placeholder: t("users.email") %>
          <%= f.label :email, t("users.email"), class: "Form__label" %>
        </div>

        <div class="form-floating Form__group">
          <%= f.telephone_field :phone, class: "form-control Form__input", placeholder: t("users.phone") %>
          <%= f.label :phone, t("users.phone"), class: "Form__label" %>
        </div>

        <div class="Form__actions">
          <%= f.submit t("common.save"), class: "Form__btn w-100" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
