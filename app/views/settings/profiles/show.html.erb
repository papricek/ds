<% content_for :title, t("settings.tabs.profile") %>

<%= render "settings/tab_navigation", active_tab: "profile" %>

<div class="Card">
  <%= form_with(model: @user, url: settings_profile_path, method: :patch, class: "Form Form--dark", html: { novalidate: true }) do |f| %>
    <div class="row">
      <div class="col-md-4">
        <div class="form-floating Form__group">
          <%= f.text_field :name, class: "form-control Form__input", placeholder: t("users.name") %>
          <%= f.label :name, t("users.name"), class: "Form__label Form__label--required" %>
        </div>
      </div>
      <div class="col-md-4">
        <div class="form-floating Form__group">
          <%= f.email_field :email, class: "form-control Form__input", placeholder: t("users.email") %>
          <%= f.label :email, t("users.email"), class: "Form__label Form__label--required" %>
        </div>
      </div>
      <div class="col-md-4">
        <div class="form-floating Form__group">
          <%= f.text_field :phone, class: "form-control Form__input", placeholder: t("users.phone") %>
          <%= f.label :phone, t("users.phone"), class: "Form__label" %>
        </div>
      </div>
    </div>

    <div class="Form__actions">
      <%= f.submit t("common.save"), class: "Form__btn", data: { disable_with: disable_with } %>
    </div>
  <% end %>
</div>
