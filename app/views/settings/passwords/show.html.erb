<% content_for :title, t("settings.tabs.password") %>

<div class="row">
  <div class="col-md-3 mb-3 mb-md-0">
    <%= render "settings/nav" %>
  </div>
  <div class="col-md-9">
    <div class="Box">
      <h1 class="Form__title"><%= t("settings.password.title") %></h1>
      <p class="Form__text"><%= t("settings.password.text") %></p>

      <%= form_with(url: settings_password_path, method: :patch, class: "Form Form--dark", html: { novalidate: true }) do |f| %>
        <div class="form-floating Form__group">
          <%= f.password_field :current_password, class: "form-control Form__input", name: "current_password", placeholder: t("settings.current_password"), autocomplete: "current-password" %>
          <%= f.label :current_password, t("settings.current_password"), class: "Form__label" %>
        </div>

        <div class="form-floating Form__group">
          <%= f.password_field :password, class: "form-control Form__input", name: "user[password]", placeholder: t("password_resets.new_password"), autocomplete: "new-password" %>
          <%= f.label :password, t("password_resets.new_password"), class: "Form__label" %>
        </div>

        <div class="form-floating Form__group">
          <%= f.password_field :password_confirmation, class: "form-control Form__input", name: "user[password_confirmation]", placeholder: t("password_resets.confirm_password"), autocomplete: "new-password" %>
          <%= f.label :password_confirmation, t("password_resets.confirm_password"), class: "Form__label" %>
        </div>

        <div class="Form__actions">
          <%= f.submit t("settings.change_password"), class: "Form__btn w-100" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
