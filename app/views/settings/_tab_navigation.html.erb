<div class="Tabs mb-4">
  <ul class="nav nav-tabs" role="tablist">
    <li class="nav-item" role="presentation">
      <%= link_to settings_profile_path, class: "nav-link #{'active' if active_tab == 'profile'}" do %>
        <i class="fas fa-user me-1"></i> <%= t("settings.tabs.profile") %>
      <% end %>
    </li>
    <li class="nav-item" role="presentation">
      <%= link_to settings_password_path, class: "nav-link #{'active' if active_tab == 'password'}" do %>
        <i class="fas fa-lock me-1"></i> <%= t("settings.tabs.password") %>
      <% end %>
    </li>
    <% unless Current.user.admin_or_superadmin? %>
      <li class="nav-item" role="presentation">
        <%= link_to settings_addresses_path, class: "nav-link #{'active' if active_tab == 'addresses'}" do %>
          <i class="fas fa-location-dot me-1"></i> <%= t("settings.tabs.addresses") %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
