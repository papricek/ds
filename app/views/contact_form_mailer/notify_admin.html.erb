<tr>
  <td class="content-block">
    <h2><%= t("contact_form_mailer.notify_admin.text") %></h2>
  </td>
</tr>
<tr>
  <td class="content-block">
    <strong><%= t("contact_form_mailer.notify_admin.name") %>:</strong> <%= @contact_form.name %><br />
    <strong><%= t("contact_form_mailer.notify_admin.email") %>:</strong> <%= mail_to @contact_form.email %><br />
    <strong><%= t("contact_form_mailer.notify_admin.phone") %>:</strong> <%= @contact_form.phone %>
    <% if @contact_form.message.present? %>
      <br /><br />
      <strong><%= t("contact_form_mailer.notify_admin.message") %>:</strong><br />
      <%= simple_format @contact_form.message %>
    <% end %>
  </td>
</tr>
