<table>
  <tbody>
    <tr>
      <td class="content-block">
        <%= t("contact_form_mailer.notify_admin.text") %>
      </td>
    </tr>
    <tr>
      <td class="content-block">
        <strong><%= t(".name") %>:</strong> <%= @contact_form.name %><br />
        <strong><%= t(".email") %>:</strong> <%= @contact_form.email %><br />
        <strong><%= t(".phone") %>:</strong> <%= @contact_form.phone %><br />
        <% if @contact_form.message.present? %>
          <strong><%= t(".message") %>:</strong> <%= @contact_form.message %><br />
        <% end %>
      </td>
    </tr>
    <%= render partial: "layouts/mailer_footer" %>
  </tbody>
</table>
