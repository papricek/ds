<% content_for :title, t("navigation.billings") %>

<div class="Listing Listing--responsive">
  <% @billings.each do |billing| %>
    <div class="Listing__item">
      <div class="Listing__content Listing__content--single-line">
        <div class="Listing__main">
          <div class="Listing__status Listing__status--<%= billing.paid? ? 'confirmed' : 'pending' %>">
            <i class="fas <%= billing.paid? ? 'fa-check' : 'fa-file-invoice' %>"></i>
          </div>
          <div class="Listing__info">
            <div class="Listing__info-primary">
              <%= link_to "#{t("billings.receipt")} #{billing.variable_symbol}", billing_path(billing) %>
              <span class="Listing__badge Listing__badge--<%= billing.paid? ? 'success' : 'warning' %>">
                <%= t("billings.statuses.#{billing.status}") %>
              </span>
            </div>
            <div class="Listing__info-secondary">
              <%= billing.start_at.strftime("%d.%m.%Y") %> — <%= billing.end_at.strftime("%d.%m.%Y") %>
            </div>
          </div>
          <div class="Listing__amount"><%= billing.subtotal.round(2) %> Kč</div>
        </div>
        <div class="Listing__actions">
          <% if billing.document.attached? %>
            <%= link_to download_billing_path(billing), class: "Button Button--primary" do %>
              <i class="fas fa-file-pdf"></i> PDF
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if @billings.empty? %>
  <div class="Listing__empty">
    <div class="Listing__empty-icon"><i class="fas fa-file-invoice"></i></div>
    <div class="Listing__empty-description"><%= t("billings.no_billings") %></div>
  </div>
<% end %>

<% if @billings.respond_to?(:total_pages) && @billings.total_pages > 1 %>
  <div class="Listing__pagination">
    <%= paginate @billings, theme: "bootstrap-5" %>
  </div>
<% end %>
