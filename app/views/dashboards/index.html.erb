<% content_for :title, "Přehled" %>

<div class="mb-4">
  <h1 class="text-white">Přehled</h1>
</div>

<div class="StatCardGrid">
  <div class="StatCard">
    <div class="StatCard__icon StatCard__icon--consumption">
      <i class="fas fa-bolt"></i>
    </div>
    <div class="StatCard__content">
      <div class="StatCard__label">Spotřeba</div>
      <div class="StatCard__value">&mdash; kWh</div>
    </div>
  </div>

  <div class="StatCard">
    <div class="StatCard__icon StatCard__icon--production">
      <i class="fas fa-solar-panel"></i>
    </div>
    <div class="StatCard__content">
      <div class="StatCard__label">Výroba</div>
      <div class="StatCard__value">&mdash; kWh</div>
    </div>
  </div>

  <div class="StatCard">
    <div class="StatCard__icon StatCard__icon--sharing">
      <i class="fas fa-share-nodes"></i>
    </div>
    <div class="StatCard__content">
      <div class="StatCard__label">Sdílení</div>
      <div class="StatCard__value">&mdash; kWh</div>
    </div>
  </div>
</div>

<div class="Card mt-4">
  <div class="Card__title">Zatím žádná data</div>
</div>
