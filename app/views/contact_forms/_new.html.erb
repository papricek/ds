<div id="contact-form">
  <div class="modal-header" style="border-bottom-color: var(--white-1);">
    <h5 class="modal-title" style="color: var(--white);">
      <i class="fas fa-envelope me-2" style="color: var(--orange);"></i>
      <%= t("contact_forms.new.heading") %>
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
  </div>
  <div class="modal-body">
    <%= render "form" %>
  </div>
</div>
