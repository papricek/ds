<div class="Sessions">
  <div class="Sessions__row">
    <div class="Sessions__column">
      <div class="Sessions__logo-container">
        <%= link_to root_path do %>
          <%= image_tag "logo_white.svg", alt: "LiteLink", class: "Sessions__logo" %>
        <% end %>
      </div>
      <div class="Sessions__container">
        <div class="Sessions__content">
          <%= render "layouts/flash" %>
          <%= yield %>
        </div>
      </div>
    </div>
  </div>
</div>
