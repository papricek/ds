<div class="Home">
  <header class="Home__hero">
    <nav class="HomeNavbar navbar navbar-expand-lg">
      <div class="container-xl">
        <%= link_to root_path, class: "navbar-brand" do %>
          <%= image_tag "logo_white.svg", alt: "LiteLink", class: "Home__logo" %>
        <% end %>
        <button class="navbar-toggler d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#homeOffcanvas">
          <i class="fas fa-bars"></i>
        </button>
        <div class="d-none d-lg-block">
          <ul class="navbar-nav w-100 align-items-center">
            <li class="nav-item">
              <a href="#features" class="nav-link"><%= t("home.nav.features") %></a>
            </li>
            <li class="nav-item">
              <a href="#pricing" class="nav-link"><%= t("home.nav.pricing") %></a>
            </li>
            <li class="nav-item">
              <a href="#contact" class="nav-link"><%= t("home.nav.contact") %></a>
            </li>
            <li class="nav-item ms-4">
              <%= link_to t("home.nav.login"), new_session_path, class: "Home__cta-btn Home__cta-btn--blue" %>
            </li>
          </ul>
        </div>

        <div class="HomeNavbar__offcanvas offcanvas offcanvas-end d-lg-none" tabindex="-1" id="homeOffcanvas">
          <div class="offcanvas-header">
            <%= image_tag "logo_white.svg", alt: "LiteLink", style: "height: 24px;" %>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <ul class="navbar-nav">
              <li class="nav-item"><a href="#features" class="nav-link" data-bs-dismiss="offcanvas"><%= t("home.nav.features") %></a></li>
              <li class="nav-item"><a href="#pricing" class="nav-link" data-bs-dismiss="offcanvas"><%= t("home.nav.pricing") %></a></li>
              <li class="nav-item"><a href="#contact" class="nav-link" data-bs-dismiss="offcanvas"><%= t("home.nav.contact") %></a></li>
              <li class="nav-item mt-3">
                <%= link_to t("home.nav.login"), new_session_path, class: "Home__cta-btn Home__cta-btn--blue" %>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </nav>

    <div class="Home__hero__container container-xl">
      <div class="Home__hero__content">
        <h1 class="Home__hero__title"><%= t("home.hero.title") %></h1>
        <p class="Home__hero__lead"><%= t("home.hero.lead") %></p>
        <p class="Home__hero__text"><%= t("home.hero.description") %></p>

        <div class="Home__hero__solutions">
          <a href="#features" class="Home__bordered-button Home__bordered-button--with-icon Home__bordered-button--icon-down">
            <%= t("home.hero.learn_more") %>
          </a>
          <%= link_to new_session_path, class: "Home__bordered-button Home__bordered-button--with-icon Home__bordered-button--icon-right" do %>
            <%= t("home.hero.cta") %>
          <% end %>
        </div>
      </div>
    </div>
  </header>

  <section class="Home__features-section" id="features">
    <div class="container-xl">
      <h2 class="Home__lead"><%= t("home.features.title") %></h2>
      <p class="Home__section-subtitle"><%= t("home.features.subtitle") %></p>

      <div class="row g-4">
        <div class="col-md-4">
          <div class="Home__box">
            <div class="Home__box__icon"><i class="fas fa-users"></i></div>
            <h3><%= t("home.features.simple.title") %></h3>
            <div class="Home__box__text"><%= t("home.features.simple.description") %></div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="Home__box">
            <div class="Home__box__icon"><i class="fas fa-chart-line"></i></div>
            <h3><%= t("home.features.dashboard.title") %></h3>
            <div class="Home__box__text"><%= t("home.features.dashboard.description") %></div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="Home__box">
            <div class="Home__box__icon"><i class="fas fa-file-invoice"></i></div>
            <h3><%= t("home.features.billing.title") %></h3>
            <div class="Home__box__text"><%= t("home.features.billing.description") %></div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="Home__box">
            <div class="Home__box__icon"><i class="fas fa-layer-group"></i></div>
            <h3><%= t("home.features.groups.title") %></h3>
            <div class="Home__box__text"><%= t("home.features.groups.description") %></div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="Home__box">
            <div class="Home__box__icon"><i class="fas fa-download"></i></div>
            <h3><%= t("home.features.edc.title") %></h3>
            <div class="Home__box__text"><%= t("home.features.edc.description") %></div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="Home__box">
            <div class="Home__box__icon"><i class="fas fa-leaf"></i></div>
            <h3><%= t("home.features.green.title") %></h3>
            <div class="Home__box__text"><%= t("home.features.green.description") %></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="Home__pricing-section" id="pricing">
    <div class="container-xl">
      <h2 class="Home__lead"><%= t("home.pricing.title") %></h2>
      <p class="Home__section-subtitle"><%= t("home.pricing.subtitle") %></p>

      <div class="row justify-content-center">
        <div class="col-md-5">
          <div class="Home__pricing-card">
            <div class="Home__pricing-badge"><%= t("home.pricing.badge") %></div>
            <div class="Home__pricing-price">
              <span class="Home__pricing-amount">490</span>
              <span class="Home__pricing-currency"><%= t("home.pricing.currency") %></span>
            </div>
            <div class="Home__pricing-period"><%= t("home.pricing.period") %></div>
            <ul class="Home__pricing-features">
              <li><i class="fas fa-check"></i> <%= t("home.pricing.includes.users") %></li>
              <li><i class="fas fa-check"></i> <%= t("home.pricing.includes.addresses") %></li>
              <li><i class="fas fa-check"></i> <%= t("home.pricing.includes.groups") %></li>
              <li><i class="fas fa-check"></i> <%= t("home.pricing.includes.billings") %></li>
              <li><i class="fas fa-check"></i> <%= t("home.pricing.includes.edc") %></li>
              <li><i class="fas fa-check"></i> <%= t("home.pricing.includes.chrome") %></li>
              <li><i class="fas fa-check"></i> <%= t("home.pricing.includes.support") %></li>
            </ul>
            <a href="#contact" class="Home__cta-btn Home__cta-btn--large"><%= t("home.pricing.cta") %></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container-xl py-5" id="contact">
    <div class="Home__message">
      <%= image_tag "logo_white.svg", style: "width: 200px;" %>
      <h2 class="Home__message__title"><%= t("home.cta.title") %></h2>
      <p class="Home__message__lead"><%= t("home.cta.description") %></p>
      <a href="mailto:info@wattlink.cz" class="Home__cta-btn Home__cta-btn--large">
        <i class="fas fa-envelope me-2"></i><%= t("home.cta.button") %>
      </a>
    </div>
  </div>

  <footer class="Home__footer">
    <div class="container-xl">
      <div class="row">
        <div class="col-md-4 mb-4">
          <h5 class="mb-3"><%= t("home.footer.about_title") %></h5>
          <p class="mb-0" style="color: var(--white-7);"><%= t("home.footer.about_text") %></p>
        </div>
        <div class="col-md-4 mb-4">
          <h5 class="mb-3"><%= t("home.footer.contact_title") %></h5>
          <ul class="list-unstyled">
            <li class="mb-2">
              <a href="mailto:info@wattlink.cz" class="text-white text-decoration-none">
                <i class="fas fa-envelope me-2"></i>info@wattlink.cz
              </a>
            </li>
            <li class="mb-2">
              <a href="https://wattlink.cz" target="_blank" class="text-white text-decoration-none">
                <i class="fas fa-globe me-2"></i>wattlink.cz
              </a>
            </li>
          </ul>
        </div>
        <div class="col-md-4 mb-4">
          <h5 class="mb-3"><%= t("home.footer.links_title") %></h5>
          <ul class="list-unstyled">
            <li class="mb-2">
              <%= link_to new_session_path, class: "text-white text-decoration-none" do %>
                <i class="fas fa-arrow-right-from-bracket me-2"></i><%= t("home.nav.login") %>
              <% end %>
            </li>
          </ul>
        </div>
      </div>

      <div class="border-top pt-4 mt-2" style="border-color: var(--white-15) !important;">
        <p class="text-center mb-0" style="color: var(--white-5);">
          &copy; <%= Time.current.year %> LiteLink by <a href="https://wattlink.cz" target="_blank" class="text-white text-decoration-none">Wattlink</a>
        </p>
      </div>
    </div>
  </footer>
</div>
