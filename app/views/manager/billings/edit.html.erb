<% content_for :title, t("billings.receipt") %>

<%= render "manager/shared/navigation" %>

<div class="mb-4">
  <h1 class="text-white"><%= t("billings.edit_billing") %></h1>
</div>

<div class="Card">
  <%= form_with(model: @billing, url: manager_billing_path(@billing), class: "Form Form--dark") do |f| %>
    <div class="row">
      <div class="col-md-4">
        <div class="Form__group">
          <%= f.label :status, t("billings.status"), class: "Form__label" %>
          <%= f.select :status, Billing.statuses.keys.map { |s| [t("billings.statuses.#{s}"), s] }, {}, class: "Form__input" %>
        </div>
      </div>
      <div class="col-md-4">
        <div class="Form__group">
          <%= f.label :issue_date, t("billings.issue_date"), class: "Form__label" %>
          <%= f.date_field :issue_date, class: "Form__input" %>
        </div>
      </div>
      <div class="col-md-4">
        <div class="Form__group">
          <%= f.label :due_date, t("billings.due_date"), class: "Form__label" %>
          <%= f.date_field :due_date, class: "Form__input" %>
        </div>
      </div>
    </div>

    <div class="d-flex gap-2 mt-3">
      <%= f.submit t("common.save"), class: "Button Button--primary", data: { disable_with: disable_with } %>
      <%= link_to t("common.cancel"), manager_billing_path(@billing), class: "Button Button--secondary" %>
    </div>
  <% end %>
</div>
