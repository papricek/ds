<% content_for :title, t("billings.receipt") %>

<%= render "manager/shared/navigation" %>

<div class="Card">
  <%= form_with(model: @billing, url: manager_billing_path(@billing), class: "Form Form--dark", html: { novalidate: true }) do |f| %>
    <div class="row">
      <div class="col-md-4">
        <div class="form-floating Form__group">
          <%= f.select :status, Billing.statuses.keys.map { |s| [t("billings.statuses.#{s}"), s] }, {}, class: "form-select Form__input" %>
          <%= f.label :status, t("billings.status"), class: "Form__label" %>
        </div>
      </div>
      <div class="col-md-4">
        <div class="form-floating Form__group">
          <%= f.date_field :issue_date, class: "form-control Form__input", placeholder: t("billings.issue_date") %>
          <%= f.label :issue_date, t("billings.issue_date"), class: "Form__label" %>
        </div>
      </div>
      <div class="col-md-4">
        <div class="form-floating Form__group">
          <%= f.date_field :due_date, class: "form-control Form__input", placeholder: t("billings.due_date") %>
          <%= f.label :due_date, t("billings.due_date"), class: "Form__label" %>
        </div>
      </div>
    </div>

    <div class="Form__actions">
      <%= link_to t("common.cancel"), manager_billing_path(@billing), class: "Form__btn-link" %>
      <%= f.submit t("common.save"), class: "Form__btn", data: { disable_with: disable_with } %>
    </div>
  <% end %>
</div>
