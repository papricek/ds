<% content_for :title, "#{t("billings.receipt")} #{@billing.variable_symbol}" %>

<%= render "manager/shared/navigation" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="text-white mb-0"><%= t("billings.receipt") %> <%= @billing.variable_symbol %></h1>
  <div class="d-flex gap-2">
    <% if @billing.document.attached? %>
      <%= link_to download_manager_billing_path(@billing), class: "Button Button--primary" do %>
        <i class="fas fa-file-pdf me-1"></i> PDF
      <% end %>
    <% end %>
    <% unless @billing.paid? %>
      <%= link_to mark_paid_manager_billing_path(@billing), data: { turbo_method: :patch }, class: "Button Button--secondary" do %>
        <i class="fas fa-check me-1"></i> <%= t("billings.mark_paid") %>
      <% end %>
    <% end %>
    <%= link_to manager_billings_path, class: "Button Button--secondary" do %>
      <i class="fas fa-arrow-left me-1"></i> <%= t("common.back") %>
    <% end %>
  </div>
</div>

<div class="row mb-4">
  <div class="col-lg-6">
    <div class="Card">
      <div class="Box">
        <div class="Box__items">
          <div class="Box__item">
            <div class="Box__item-icon"><i class="fas fa-user"></i></div>
            <div class="Box__item-main">
              <div class="Box__item-label"><%= t("users.name") %></div>
              <div class="Box__item-value"><%= @billing.user.name %></div>
            </div>
          </div>
          <div class="Box__item">
            <div class="Box__item-icon"><i class="fas fa-calendar"></i></div>
            <div class="Box__item-main">
              <div class="Box__item-label"><%= t("billings.period") %></div>
              <div class="Box__item-value"><%= @billing.start_at.strftime("%d.%m.%Y") %> — <%= @billing.end_at.strftime("%d.%m.%Y") %></div>
            </div>
          </div>
          <div class="Box__item">
            <div class="Box__item-icon"><i class="fas fa-circle-check"></i></div>
            <div class="Box__item-main">
              <div class="Box__item-label"><%= t("billings.status") %></div>
              <div class="Box__item-value">
                <span class="Badge Badge--<%= @billing.paid? ? 'success' : 'warning' %>">
                  <%= t("billings.statuses.#{@billing.status}") %>
                </span>
              </div>
            </div>
          </div>
          <div class="Box__item">
            <div class="Box__item-icon"><i class="fas fa-hashtag"></i></div>
            <div class="Box__item-main">
              <div class="Box__item-label"><%= t("billings.variable_symbol") %></div>
              <div class="Box__item-value"><%= copyable_field(@billing.variable_symbol) %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="Card">
      <div class="Box">
        <div class="Box__items">
          <div class="Box__item">
            <div class="Box__item-icon"><i class="fas fa-bolt"></i></div>
            <div class="Box__item-main">
              <div class="Box__item-label">kWh</div>
              <div class="Box__item-value"><%= @billing.total_kwh.round(2) %> kWh</div>
            </div>
          </div>
          <div class="Box__item">
            <div class="Box__item-icon"><i class="fas fa-coins"></i></div>
            <div class="Box__item-main">
              <div class="Box__item-label"><%= t("billings.amount") %></div>
              <div class="Box__item-value"><%= @billing.subtotal.round(2) %> Kč</div>
            </div>
          </div>
          <div class="Box__item">
            <div class="Box__item-icon"><i class="fas fa-calendar-check"></i></div>
            <div class="Box__item-main">
              <div class="Box__item-label"><%= t("billings.issue_date") %></div>
              <div class="Box__item-value"><%= @billing.issue_date&.strftime("%d.%m.%Y") || "—" %></div>
            </div>
          </div>
          <div class="Box__item">
            <div class="Box__item-icon"><i class="fas fa-clock"></i></div>
            <div class="Box__item-main">
              <div class="Box__item-label"><%= t("billings.due_date") %></div>
              <div class="Box__item-value"><%= @billing.due_date&.strftime("%d.%m.%Y") || "—" %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="Card">
  <div class="Card__title"><%= t("billings.items") %></div>
  <div class="Table">
    <table>
      <thead>
        <tr>
          <th><%= t("billings.counterparty") %></th>
          <th><%= t("billings.type") %></th>
          <th>kWh</th>
          <th><%= t("billings.amount") %> (Kč)</th>
        </tr>
      </thead>
      <tbody>
        <% @billing_items.each do |item| %>
          <tr>
            <td><%= item.name %></td>
            <td>
              <span class="Badge Badge--<%= item.receive? ? 'production' : 'consumption' %> Badge--small">
                <%= item.receive? ? t("billings.receive") : t("billings.pay") %>
              </span>
            </td>
            <td><%= item.amount.round(2) %></td>
            <td><%= item.price.round(2) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr style="font-weight: 600;">
          <td colspan="2"><%= t("billings.total") %></td>
          <td><%= @billing.total_kwh.round(2) %></td>
          <td><%= @billing.subtotal.round(2) %> Kč</td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
