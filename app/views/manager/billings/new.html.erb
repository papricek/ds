<% content_for :title, t("common.create") %>

<%= render "manager/shared/navigation" %>

<div class="Card">
  <%= form_with(url: manager_billings_path, method: :post, class: "Form Form--dark", html: { novalidate: true }) do |f| %>
    <div class="row">
      <div class="col-md-4">
        <div class="form-floating Form__group">
          <%= f.select :user_id,
            Current.account.users.order(:name).map { |u| [u.name, u.id] },
            { prompt: "—" },
            class: "form-select Form__input", name: "billing[user_id]" %>
          <%= f.label :user_id, t("users.name"), class: "Form__label Form__label--required" %>
        </div>
      </div>
      <div class="col-md-4">
        <div class="form-floating Form__group">
          <%= f.date_field :start_at, class: "form-control Form__input", value: 1.month.ago.beginning_of_month.to_date, name: "billing[start_at]", placeholder: t("billings.period_from") %>
          <%= f.label :start_at, t("billings.period_from"), class: "Form__label Form__label--required" %>
        </div>
      </div>
      <div class="col-md-4">
        <div class="form-floating Form__group">
          <%= f.date_field :end_at, class: "form-control Form__input", value: 1.month.ago.end_of_month.to_date, name: "billing[end_at]", placeholder: t("billings.period_to") %>
          <%= f.label :end_at, t("billings.period_to"), class: "Form__label Form__label--required" %>
        </div>
      </div>
    </div>

    <div class="Form__actions">
      <%= link_to t("common.cancel"), manager_billings_path, class: "Form__btn-link" %>
      <%= f.submit t("common.create"), class: "Form__btn", data: { disable_with: disable_with } %>
    </div>
  <% end %>
</div>
