<% content_for :title, t("common.create") %>

<%= render "manager/shared/navigation" %>

<div class="mb-4">
  <h1 class="text-white"><%= t("billings.new_billing") %></h1>
</div>

<div class="Card">
  <%= form_with(url: manager_billings_path, method: :post, class: "Form") do |f| %>
    <div class="row">
      <div class="col-md-4">
        <div class="Form__group">
          <%= f.label :user_id, t("users.name"), class: "Form__label Form__label--required" %>
          <%= f.select :user_id,
            Current.account.users.order(:name).map { |u| [u.name, u.id] },
            { prompt: "—" },
            class: "Form__input", name: "billing[user_id]" %>
        </div>
      </div>
      <div class="col-md-4">
        <div class="Form__group">
          <%= f.label :start_at, t("billings.period_from"), class: "Form__label Form__label--required" %>
          <%= f.date_field :start_at, class: "Form__input", value: 1.month.ago.beginning_of_month.to_date, name: "billing[start_at]" %>
        </div>
      </div>
      <div class="col-md-4">
        <div class="Form__group">
          <%= f.label :end_at, t("billings.period_to"), class: "Form__label Form__label--required" %>
          <%= f.date_field :end_at, class: "Form__input", value: 1.month.ago.end_of_month.to_date, name: "billing[end_at]" %>
        </div>
      </div>
    </div>

    <div class="d-flex gap-2 mt-3">
      <%= f.submit t("common.create"), class: "Button Button--primary", data: { disable_with: disable_with } %>
      <%= link_to t("common.cancel"), manager_billings_path, class: "Button Button--secondary" %>
    </div>
  <% end %>
</div>
