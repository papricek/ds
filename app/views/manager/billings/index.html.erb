<% content_for :title, t("navigation.billings") %>

<%= render "manager/shared/navigation" %>

<div class="d-flex justify-content-end gap-2 mb-3">
  <%= link_to export_manager_billings_path(format: :csv), class: "Button Button--secondary" do %>
    <i class="fas fa-download me-1"></i> CSV
  <% end %>
  <%= link_to batch_new_manager_billings_path, class: "Button Button--secondary" do %>
    <i class="fas fa-layer-group me-1"></i> <%= t("billings.batch") %>
  <% end %>
  <%= link_to new_manager_billing_path, class: "Button Button--primary" do %>
    <i class="fas fa-plus me-1"></i> <%= t("common.create") %>
  <% end %>
</div>

<div class="Listing Listing--responsive">
  <% @billings.each do |billing| %>
    <div class="Listing__item">
      <div class="Listing__content Listing__content--single-line">
        <div class="Listing__main">
          <div class="Listing__status Listing__status--<%= billing.paid? ? 'confirmed' : 'pending' %>">
            <i class="fas <%= billing.paid? ? 'fa-check' : 'fa-file-invoice' %>"></i>
          </div>
          <div class="Listing__info">
            <div class="Listing__info-primary">
              <%= link_to billing.variable_symbol || billing.id, manager_billing_path(billing) %>
              <span class="Listing__badge Listing__badge--<%= billing.paid? ? 'success' : 'warning' %>">
                <%= t("billings.statuses.#{billing.status}") %>
              </span>
            </div>
            <div class="Listing__info-secondary">
              <%= billing.user.name %> · <%= billing.start_at.strftime("%d.%m.%Y") %> — <%= billing.end_at.strftime("%d.%m.%Y") %>
            </div>
          </div>
          <div class="Listing__amount"><%= billing.subtotal.round(2) %> Kč</div>
        </div>
        <div class="Listing__actions">
          <% unless billing.paid? %>
            <%= link_to mark_paid_manager_billing_path(billing), data: { turbo_method: :patch }, class: "Button Button--success Button--small" do %>
              <i class="fas fa-check"></i> <%= t("billings.mark_paid") %>
            <% end %>
          <% end %>
          <%= link_to manager_billing_path(billing), data: { turbo_method: :delete, turbo_confirm: t("common.confirm_delete") }, class: "Button Button--danger Button--small" do %>
            <i class="fas fa-trash"></i> <%= t("common.delete") %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if @billings.respond_to?(:total_pages) && @billings.total_pages > 1 %>
  <div class="Listing__pagination">
    <%= paginate @billings, theme: "bootstrap-5" %>
  </div>
<% end %>
