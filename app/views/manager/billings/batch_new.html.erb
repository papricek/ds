<% content_for :title, t("billings.batch") %>

<%= render "manager/shared/navigation" %>

<div class="Card">
  <%= form_with(url: batch_create_manager_billings_path, method: :post, class: "Form Form--dark", html: { novalidate: true }) do |f| %>
    <p style="color: var(--white-7);"><%= t("billings.batch_description") %></p>

    <div class="row">
      <div class="col-md-6">
        <div class="form-floating Form__group">
          <%= f.date_field :start_at, class: "form-control Form__input", value: @start_at, name: "start_at", placeholder: t("billings.period_from") %>
          <%= f.label :start_at, t("billings.period_from"), class: "Form__label Form__label--required" %>
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-floating Form__group">
          <%= f.date_field :end_at, class: "form-control Form__input", value: @end_at, name: "end_at", placeholder: t("billings.period_to") %>
          <%= f.label :end_at, t("billings.period_to"), class: "Form__label Form__label--required" %>
        </div>
      </div>
    </div>

    <div class="Form__actions">
      <%= link_to t("common.cancel"), manager_billings_path, class: "Form__btn-link" %>
      <%= f.submit t("billings.generate_batch"), class: "Form__btn", data: { disable_with: disable_with } %>
    </div>
  <% end %>
</div>
