<% content_for :title, t("billings.batch") %>

<%= render "manager/shared/navigation" %>

<div class="mb-4">
  <h1 class="text-white"><%= t("billings.batch") %></h1>
</div>

<div class="Card">
  <%= form_with(url: batch_create_manager_billings_path, method: :post, class: "Form") do |f| %>
    <p style="color: var(--white-7);"><%= t("billings.batch_description") %></p>

    <div class="row">
      <div class="col-md-6">
        <div class="Form__group">
          <%= f.label :start_at, t("billings.period_from"), class: "Form__label Form__label--required" %>
          <%= f.date_field :start_at, class: "Form__input", value: @start_at, name: "start_at" %>
        </div>
      </div>
      <div class="col-md-6">
        <div class="Form__group">
          <%= f.label :end_at, t("billings.period_to"), class: "Form__label Form__label--required" %>
          <%= f.date_field :end_at, class: "Form__input", value: @end_at, name: "end_at" %>
        </div>
      </div>
    </div>

    <div class="d-flex gap-2 mt-3">
      <%= f.submit t("billings.generate_batch"), class: "Button Button--primary", data: { disable_with: disable_with } %>
      <%= link_to t("common.cancel"), manager_billings_path, class: "Button Button--secondary" %>
    </div>
  <% end %>
</div>
