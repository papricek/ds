<% content_for :title, t("navigation.groups") %>

<%= render "manager/shared/navigation" %>

<div class="d-flex justify-content-end mb-3">
  <%= link_to new_manager_group_path, class: "Button Button--primary" do %>
    <i class="fas fa-plus me-1"></i> <%= t("common.create") %>
  <% end %>
</div>

<div class="Listing Listing--responsive">
  <% @groups.each do |group| %>
    <div class="Listing__item">
      <div class="Listing__content Listing__content--single-line">
        <div class="Listing__main">
          <div class="Listing__status">
            <i class="fas fa-layer-group"></i>
          </div>
          <div class="Listing__info">
            <div class="Listing__info-primary">
              <%= link_to group.name, manager_group_path(group) %>
            </div>
            <div class="Listing__info-secondary"><%= group.identifier %></div>
          </div>
          <div class="Listing__badges">
            <span class="Listing__badge Listing__badge--success">
              <i class="fas fa-users"></i> <%= group.customers_count %>
            </span>
            <span class="Listing__badge Listing__badge--warning">
              <i class="fas fa-solar-panel"></i> <%= group.suppliers_count %>
            </span>
          </div>
        </div>
        <div class="Listing__actions">
          <%= link_to edit_manager_group_path(group), class: "Listing__action Listing__action--secondary" do %>
            <i class="fas fa-pen"></i> <%= t("common.edit") %>
          <% end %>
          <%= link_to manager_group_path(group), data: { turbo_method: :delete, turbo_confirm: t("common.confirm_delete") }, class: "Listing__action Listing__action--danger" do %>
            <i class="fas fa-trash"></i> <%= t("common.delete") %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if @groups.respond_to?(:total_pages) && @groups.total_pages > 1 %>
  <div class="Listing__pagination">
    <%= paginate @groups, theme: "bootstrap-5" %>
  </div>
<% end %>
