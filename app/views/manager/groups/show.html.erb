<% content_for :title, @group.name %>

<%= render "manager/shared/navigation" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="text-white mb-0"><%= @group.name %></h1>
  <div class="d-flex gap-2">
    <%= link_to create_sharings_manager_group_path(@group), data: { turbo_method: :post, turbo_confirm: t("groups.confirm_create_sharings") }, class: "Button Button--primary" do %>
      <i class="fas fa-share-nodes me-1"></i> <%= t("groups.generate_sharings") %>
    <% end %>
    <%= link_to edit_manager_group_path(@group), class: "Button Button--secondary" do %>
      <i class="fas fa-pen me-1"></i> <%= t("common.edit") %>
    <% end %>
    <%= link_to manager_groups_path, class: "Button Button--secondary" do %>
      <i class="fas fa-arrow-left me-1"></i> <%= t("common.back") %>
    <% end %>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-4">
    <div class="StatCard">
      <div class="StatCard__icon StatCard__icon--consumption">
        <i class="fas fa-users"></i>
      </div>
      <div class="StatCard__content">
        <div class="StatCard__label"><%= t("groups.customers_count") %></div>
        <div class="StatCard__value"><%= @group.customers_count %></div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="StatCard">
      <div class="StatCard__icon StatCard__icon--production">
        <i class="fas fa-solar-panel"></i>
      </div>
      <div class="StatCard__content">
        <div class="StatCard__label"><%= t("groups.suppliers_count") %></div>
        <div class="StatCard__value"><%= @group.suppliers_count %></div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="StatCard">
      <div class="StatCard__icon StatCard__icon--sharing">
        <i class="fas fa-share-nodes"></i>
      </div>
      <div class="StatCard__content">
        <div class="StatCard__label"><%= t("groups.sharing_pairs") %></div>
        <div class="StatCard__value"><%= @group.unique_sharing_pairs.size %></div>
      </div>
    </div>
  </div>
</div>

<div class="Card mb-4">
  <div class="Card__title d-flex justify-content-between align-items-center">
    <span><%= t("groups.customers") %></span>
  </div>

  <%= form_with(url: manager_group_group_customers_path(@group), class: "Form d-flex gap-2 align-items-end p-3", style: "border-bottom: 1px solid var(--white-1);") do |f| %>
    <div class="Form__group mb-0 flex-grow-1">
      <%= f.label :ean, t("addresses.ean"), class: "Form__label" %>
      <%= f.text_field :ean, class: "Form__input", placeholder: "859182400...", name: "group_customer[ean]" %>
    </div>
    <div class="Form__group mb-0">
      <%= f.label :valid_from, t("groups.valid_from"), class: "Form__label" %>
      <%= f.date_field :valid_from, class: "Form__input", name: "group_customer[valid_from]" %>
    </div>
    <div class="Form__group mb-0">
      <%= f.label :valid_to, t("groups.valid_to"), class: "Form__label" %>
      <%= f.date_field :valid_to, class: "Form__input", name: "group_customer[valid_to]" %>
    </div>
    <%= f.submit t("groups.add_customer"), class: "Button Button--primary" %>
  <% end %>

  <% @group_customers.each do |gc| %>
    <div class="p-3" style="border-bottom: 1px solid var(--white-1);">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center gap-2">
          <span class="Badge Badge--consumption"><%= gc.ean %></span>
          <% if gc.valid_from || gc.valid_to %>
            <small style="color: var(--white-5);">
              <%= gc.valid_from&.strftime("%d.%m.%Y") %> — <%= gc.valid_to&.strftime("%d.%m.%Y") %>
            </small>
          <% end %>
        </div>
        <%= link_to manager_group_group_customer_path(@group, gc), data: { turbo_method: :delete, turbo_confirm: t("common.confirm_delete") }, class: "Button Button--destroy Button--small" do %>
          <i class="fas fa-times"></i>
        <% end %>
      </div>

      <div class="ms-4">
        <% gc.group_supplier_allocations.each do |gsa| %>
          <div class="d-flex align-items-center gap-2 mb-1">
            <span class="Badge Badge--production Badge--small"><%= gsa.ean %></span>
            <small style="color: var(--white-5);"><%= (gsa.allocation_ratio * 100).round(1) %>%</small>
            <%= link_to manager_group_group_customer_group_supplier_allocation_path(@group, gc, gsa), data: { turbo_method: :delete, turbo_confirm: t("common.confirm_delete") }, class: "Button Button--destroy Button--small" do %>
              <i class="fas fa-times" style="font-size: 0.7em;"></i>
            <% end %>
          </div>
        <% end %>

        <%= form_with(url: manager_group_group_customer_group_supplier_allocations_path(@group, gc), class: "d-flex gap-2 align-items-end mt-1") do |f| %>
          <%= f.text_field :ean, class: "Form__input", placeholder: t("groups.supplier_ean"), name: "group_supplier_allocation[ean]", style: "max-width: 250px;" %>
          <%= f.number_field :allocation_ratio, class: "Form__input", value: 1.0, step: 0.01, min: 0, max: 1, name: "group_supplier_allocation[allocation_ratio]", style: "max-width: 100px;" %>
          <%= f.submit t("groups.add_supplier"), class: "Button Button--secondary Button--small" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
