<%= form_with(model: @group, url: url, class: "Form Form--dark", html: { novalidate: true }) do |f| %>
  <div class="row">
    <div class="col-md-6">
      <div class="form-floating Form__group">
        <%= f.text_field :name, class: "form-control Form__input #{error_class_for(@group, :name)}", placeholder: t("groups.name") %>
        <%= f.label :name, t("groups.name"), class: "Form__label Form__label--required" %>
        <%= error_message_for(@group, :name) %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-floating Form__group">
        <%= f.text_field :identifier, class: "form-control Form__input", placeholder: t("groups.identifier") %>
        <%= f.label :identifier, t("groups.identifier"), class: "Form__label" %>
      </div>
    </div>
  </div>

  <div class="Form__actions">
    <%= link_to t("common.cancel"), manager_groups_path, class: "Form__btn-link" %>
    <%= f.submit @group.new_record? ? t("common.create") : t("common.save"), class: "Form__btn", data: { disable_with: disable_with } %>
  </div>
<% end %>
