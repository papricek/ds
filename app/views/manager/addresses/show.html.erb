<% content_for :title, @address.label.presence || @address.ean %>

<%= render "manager/shared/navigation" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="text-white mb-0"><%= @address.label.presence || @address.ean %></h1>
  <div class="d-flex gap-2">
    <%= link_to edit_manager_address_path(@address), class: "Button Button--secondary" do %>
      <i class="fas fa-pen me-1"></i> <%= t("common.edit") %>
    <% end %>
    <%= link_to manager_addresses_path, class: "Button Button--secondary" do %>
      <i class="fas fa-arrow-left me-1"></i> <%= t("common.back") %>
    <% end %>
  </div>
</div>

<div class="Card">
  <div class="Box">
    <div class="Box__items">
      <div class="Box__item">
        <div class="Box__item-icon"><i class="fas fa-barcode"></i></div>
        <div class="Box__item-main">
          <div class="Box__item-label"><%= t("addresses.ean") %></div>
          <div class="Box__item-value"><%= copyable_field(@address.ean) %></div>
        </div>
      </div>
      <div class="Box__item">
        <div class="Box__item-icon"><i class="fas fa-user"></i></div>
        <div class="Box__item-main">
          <div class="Box__item-label"><%= t("users.name") %></div>
          <div class="Box__item-value"><%= link_to @address.user.name, manager_user_path(@address.user), style: "color: var(--brand-primary);" %></div>
        </div>
      </div>
      <div class="Box__item">
        <div class="Box__item-icon"><i class="fas fa-tag"></i></div>
        <div class="Box__item-main">
          <div class="Box__item-label"><%= t("addresses.role") %></div>
          <div class="Box__item-value">
            <span class="Badge Badge--<%= @address.customer? ? 'consumption' : 'production' %>">
              <%= t("addresses.roles.#{@address.role}") %>
            </span>
          </div>
        </div>
      </div>
      <div class="Box__item">
        <div class="Box__item-icon"><i class="fas fa-map-marker-alt"></i></div>
        <div class="Box__item-main">
          <div class="Box__item-label"><%= t("addresses.street") %></div>
          <div class="Box__item-value"><%= [@address.street, @address.city, @address.zip].compact_blank.join(", ").presence || "—" %></div>
        </div>
      </div>
    </div>
  </div>
</div>
