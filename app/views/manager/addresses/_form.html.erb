<%= form_with(model: @address, url: url, class: "Form Form--dark", html: { novalidate: true }) do |f| %>
  <div class="row">
    <div class="col-md-6">
      <div class="form-floating Form__group">
        <%= f.select :user_id,
          Current.account.users.order(:name).map { |u| [u.name, u.id] },
          { prompt: "—" },
          class: "form-select Form__input #{error_class_for(@address, :user_id)}" %>
        <%= f.label :user_id, t("users.name"), class: "Form__label Form__label--required" %>
        <%= error_message_for(@address, :user_id) %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-floating Form__group">
        <%= f.text_field :ean, class: "form-control Form__input #{error_class_for(@address, :ean)}", placeholder: "859182400..." %>
        <%= f.label :ean, t("addresses.ean"), class: "Form__label Form__label--required" %>
        <%= error_message_for(@address, :ean) %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="Form__group">
        <label class="Form__label" style="color: var(--light-gray);"><%= t("addresses.role") %></label>
        <div class="btn-group w-100" role="group" data-controller="button-selection">
          <%= f.radio_button :role, "customer", class: "btn-check", id: "role_customer", autocomplete: "off" %>
          <%= f.label "role_customer", class: "btn btn-outline-primary me-2", for: "role_customer" do %>
            <i class="fas fa-check me-1 d-none check-icon"></i>
            <i class="fas fa-house me-1"></i> <%= t("addresses.roles.customer") %>
          <% end %>
          <%= f.radio_button :role, "supplier", class: "btn-check", id: "role_supplier", autocomplete: "off" %>
          <%= f.label "role_supplier", class: "btn btn-outline-primary", for: "role_supplier" do %>
            <i class="fas fa-check me-1 d-none check-icon"></i>
            <i class="fas fa-solar-panel me-1"></i> <%= t("addresses.roles.supplier") %>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-floating Form__group">
        <%= f.text_field :label, class: "form-control Form__input", placeholder: t("addresses.label") %>
        <%= f.label :label, t("addresses.label"), class: "Form__label" %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-4">
      <div class="form-floating Form__group">
        <%= f.text_field :street, class: "form-control Form__input", placeholder: t("addresses.street") %>
        <%= f.label :street, t("addresses.street"), class: "Form__label" %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="form-floating Form__group">
        <%= f.text_field :city, class: "form-control Form__input", placeholder: t("addresses.city") %>
        <%= f.label :city, t("addresses.city"), class: "Form__label" %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="form-floating Form__group">
        <%= f.text_field :zip, class: "form-control Form__input", placeholder: t("addresses.zip") %>
        <%= f.label :zip, t("addresses.zip"), class: "Form__label" %>
      </div>
    </div>
  </div>

  <div class="Form__actions">
    <%= link_to t("common.cancel"), manager_addresses_path, class: "Form__btn-link" %>
    <%= f.submit @address.new_record? ? t("common.create") : t("common.save"), class: "Form__btn", data: { disable_with: disable_with } %>
  </div>
<% end %>
