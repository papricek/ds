<% content_for :title, t("navigation.addresses") %>

<%= render "manager/shared/navigation" %>

<div class="d-flex justify-content-end mb-3">
  <%= link_to new_manager_address_path, class: "Button Button--primary" do %>
    <i class="fas fa-plus me-1"></i> <%= t("common.create") %>
  <% end %>
</div>

<div class="Card">
  <div class="Table Table--hoverable">
    <table>
      <thead>
        <tr>
          <th><%= t("addresses.ean") %></th>
          <th><%= t("users.name") %></th>
          <th><%= t("addresses.role") %></th>
          <th><%= t("addresses.label") %></th>
          <th><%= t("addresses.city") %></th>
          <th><%= t("common.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @addresses.each do |address| %>
          <tr>
            <td><%= copyable_field(address.ean) %></td>
            <td><%= link_to address.user.name, manager_user_path(address.user), style: "color: var(--brand-primary);" %></td>
            <td>
              <span class="Badge Badge--<%= address.customer? ? 'consumption' : 'production' %> Badge--small">
                <%= t("addresses.roles.#{address.role}") %>
              </span>
            </td>
            <td><%= address.label %></td>
            <td><%= address.city %></td>
            <td>
              <div class="d-flex gap-1">
                <%= link_to edit_manager_address_path(address), class: "Button Button--edit Button--small" do %>
                  <i class="fas fa-pen"></i>
                <% end %>
                <%= link_to manager_address_path(address), data: { turbo_method: :delete, turbo_confirm: t("common.confirm_delete") }, class: "Button Button--destroy Button--small" do %>
                  <i class="fas fa-trash"></i>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @addresses.respond_to?(:total_pages) && @addresses.total_pages > 1 %>
  <div class="Listing__pagination mt-3">
    <%= paginate @addresses, theme: "bootstrap-5" %>
  </div>
<% end %>
