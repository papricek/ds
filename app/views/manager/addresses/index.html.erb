<% content_for :title, t("navigation.addresses") %>

<%= render "manager/shared/navigation" %>

<div class="d-flex justify-content-end mb-3">
  <%= link_to new_manager_address_path, class: "Listing__action Listing__action--primary" do %>
    <i class="fas fa-plus"></i> <%= t("common.create") %>
  <% end %>
</div>

<div class="Listing Listing--responsive">
  <% @addresses.each do |address| %>
    <div class="Listing__item">
      <div class="Listing__content Listing__content--single-line">
        <div class="Listing__main">
          <div class="Listing__status Listing__status--<%= address.customer? ? 'customer' : 'supplier' %>">
            <i class="fas <%= address.customer? ? 'fa-house' : 'fa-solar-panel' %>"></i>
          </div>
          <div class="Listing__info">
            <div class="Listing__info-primary"><%= copyable_field(address.ean) %></div>
            <div class="Listing__info-secondary"><%= address.user.name %> · <%= [address.label, address.city].compact_blank.join(", ") %></div>
          </div>
          <div class="Listing__badges">
            <span class="Listing__badge Listing__badge--<%= address.customer? ? 'success' : 'warning' %>">
              <%= t("addresses.roles.#{address.role}") %>
            </span>
          </div>
        </div>
        <div class="Listing__actions">
          <%= link_to edit_manager_address_path(address), class: "Listing__action Listing__action--secondary" do %>
            <i class="fas fa-pen"></i> <%= t("common.edit") %>
          <% end %>
          <%= link_to manager_address_path(address), data: { turbo_method: :delete, turbo_confirm: t("common.confirm_delete") }, class: "Listing__action Listing__action--danger" do %>
            <i class="fas fa-trash"></i> <%= t("common.delete") %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if @addresses.respond_to?(:total_pages) && @addresses.total_pages > 1 %>
  <div class="Listing__pagination">
    <%= paginate @addresses, theme: "bootstrap-5" %>
  </div>
<% end %>
