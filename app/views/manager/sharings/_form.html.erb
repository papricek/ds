<%= form_with(model: @sharing, url: url, class: "Form Form--dark") do |f| %>
  <div class="row">
    <div class="col-md-6">
      <div class="form-floating Form__group">
        <%= f.select :from_address_id,
          Current.account.addresses.supplier.includes(:user).order(:ean).map { |a| ["#{a.ean} (#{a.user.name})", a.id] },
          { prompt: "—" },
          class: "form-select Form__input #{error_class_for(@sharing, :from_address_id)}" %>
        <%= f.label :from_address_id, t("sharings.from_ean"), class: "Form__label Form__label--required" %>
        <%= error_message_for(@sharing, :from_address_id) %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-floating Form__group">
        <%= f.select :to_address_id,
          Current.account.addresses.customer.includes(:user).order(:ean).map { |a| ["#{a.ean} (#{a.user.name})", a.id] },
          { prompt: "—" },
          class: "form-select Form__input #{error_class_for(@sharing, :to_address_id)}" %>
        <%= f.label :to_address_id, t("sharings.to_ean"), class: "Form__label Form__label--required" %>
        <%= error_message_for(@sharing, :to_address_id) %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="form-floating Form__group">
        <%= f.number_field :fixed_price, class: "form-control Form__input", step: 0.01, min: 0, placeholder: t("sharings.price") %>
        <%= f.label :fixed_price, t("sharings.price"), class: "Form__label" %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-floating Form__group">
        <%= f.select :status, Sharing.statuses.keys.map { |s| [t("sharings.statuses.#{s}"), s] }, {}, class: "form-select Form__input" %>
        <%= f.label :status, t("sharings.status"), class: "Form__label" %>
      </div>
    </div>
  </div>

  <div class="Form__actions">
    <%= link_to t("common.cancel"), manager_sharings_path, class: "Button Button--secondary" %>
    <%= f.submit @sharing.new_record? ? t("common.create") : t("common.save"), class: "Button Button--primary", data: { disable_with: disable_with } %>
  </div>
<% end %>
