<% content_for :title, "#{@sharing.from_ean} → #{@sharing.to_ean}" %>
<%= render "manager/shared/navigation" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="text-white mb-0"><%= @sharing.from_ean %> → <%= @sharing.to_ean %></h1>
  <div class="d-flex gap-2">
    <%= link_to edit_manager_sharing_path(@sharing), class: "Button Button--secondary" do %>
      <i class="fas fa-pen me-1"></i> <%= t("common.edit") %>
    <% end %>
    <%= link_to manager_sharings_path, class: "Button Button--secondary" do %>
      <i class="fas fa-arrow-left me-1"></i> <%= t("common.back") %>
    <% end %>
  </div>
</div>

<div class="Card">
  <div class="Box">
    <div class="Box__items">
      <div class="Box__item">
        <div class="Box__item-icon"><i class="fas fa-solar-panel"></i></div>
        <div class="Box__item-main">
          <div class="Box__item-label"><%= t("sharings.from_ean") %></div>
          <div class="Box__item-value">
            <%= copyable_field(@sharing.from_ean) %>
            <small style="color: var(--white-5);"><%= @sharing.supplier&.name %></small>
          </div>
        </div>
      </div>
      <div class="Box__item">
        <div class="Box__item-icon"><i class="fas fa-house"></i></div>
        <div class="Box__item-main">
          <div class="Box__item-label"><%= t("sharings.to_ean") %></div>
          <div class="Box__item-value">
            <%= copyable_field(@sharing.to_ean) %>
            <small style="color: var(--white-5);"><%= @sharing.customer&.name %></small>
          </div>
        </div>
      </div>
      <div class="Box__item">
        <div class="Box__item-icon"><i class="fas fa-coins"></i></div>
        <div class="Box__item-main">
          <div class="Box__item-label"><%= t("sharings.price") %></div>
          <div class="Box__item-value"><%= @sharing.fixed_price ? "#{@sharing.fixed_price} Kč/kWh" : "—" %></div>
        </div>
      </div>
      <div class="Box__item">
        <div class="Box__item-icon"><i class="fas fa-circle-check"></i></div>
        <div class="Box__item-main">
          <div class="Box__item-label"><%= t("sharings.status") %></div>
          <div class="Box__item-value">
            <span class="Badge Badge--<%= @sharing.active? ? 'success' : @sharing.pending? ? 'warning' : 'neutral' %>">
              <%= t("sharings.statuses.#{@sharing.status}") %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
