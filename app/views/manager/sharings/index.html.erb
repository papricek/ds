<% content_for :title, t("navigation.sharings") %>

<%= render "manager/shared/navigation" %>

<div class="d-flex justify-content-end mb-3">
  <%= link_to new_manager_sharing_path, class: "Button Button--primary" do %>
    <i class="fas fa-plus me-1"></i> <%= t("common.create") %>
  <% end %>
</div>

<div class="Listing Listing--responsive">
  <% @sharings.each do |sharing| %>
    <div class="Listing__item">
      <div class="Listing__content Listing__content--single-line">
        <div class="Listing__main">
          <div class="Listing__status Listing__status--combined">
            <i class="fas fa-share-nodes"></i>
          </div>
          <div class="Listing__info">
            <div class="Listing__info-primary"><%= sharing.from_ean %> → <%= sharing.to_ean %></div>
            <div class="Listing__info-secondary"><%= sharing.from_address&.user&.name %> → <%= sharing.to_address&.user&.name %></div>
          </div>
          <div class="Listing__badges">
            <% if sharing.fixed_price %>
              <span class="Listing__badge Listing__badge--info"><%= sharing.fixed_price %> Kč/kWh</span>
            <% end %>
            <span class="Listing__badge Listing__badge--<%= sharing.active? ? 'success' : sharing.pending? ? 'warning' : 'secondary' %>">
              <%= t("sharings.statuses.#{sharing.status}") %>
            </span>
          </div>
        </div>
        <div class="Listing__actions">
          <%= link_to edit_manager_sharing_path(sharing), class: "Listing__action Listing__action--secondary" do %>
            <i class="fas fa-pen"></i> <%= t("common.edit") %>
          <% end %>
          <%= link_to manager_sharing_path(sharing), data: { turbo_method: :delete, turbo_confirm: t("common.confirm_delete") }, class: "Listing__action Listing__action--danger" do %>
            <i class="fas fa-trash"></i> <%= t("common.delete") %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if @sharings.respond_to?(:total_pages) && @sharings.total_pages > 1 %>
  <div class="Listing__pagination">
    <%= paginate @sharings, theme: "bootstrap-5" %>
  </div>
<% end %>
