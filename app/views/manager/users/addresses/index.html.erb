<% content_for :title, @user.name %>

<%= render "manager/shared/navigation" %>
<%= render "manager/users/tab_navigation", active_tab: "addresses" %>

<div class="mt-3">
  <div class="d-flex justify-content-end mb-3">
    <%= link_to new_manager_user_address_path(@user), class: "Button Button--primary" do %>
      <i class="fas fa-plus me-1"></i> <%= t("common.create") %>
    <% end %>
  </div>

  <div class="Listing Listing--responsive">
    <% @addresses.each do |address| %>
      <div class="Listing__item">
        <div class="Listing__content Listing__content--single-line">
          <div class="Listing__main">
            <div class="Listing__status Listing__status--<%= address.customer? ? 'customer' : 'supplier' %>">
              <i class="fas <%= address.customer? ? 'fa-house' : 'fa-solar-panel' %>"></i>
            </div>
            <div class="Listing__info">
              <div class="Listing__info-primary">
                <%= copyable_field(address.ean) %>
                <span class="Listing__badge Listing__badge--<%= address.customer? ? 'success' : 'warning' %>">
                  <%= t("addresses.roles.#{address.role}") %>
                </span>
              </div>
              <div class="Listing__info-secondary"><%= [address.label, address.street].compact_blank.join(" · ") %></div>
            </div>
          </div>
          <div class="Listing__actions">
            <%= link_to edit_manager_user_address_path(@user, address), class: "Button Button--secondary Button--small" do %>
              <i class="fas fa-pen"></i> <%= t("common.edit") %>
            <% end %>
            <%= link_to manager_user_address_path(@user, address), data: { turbo_method: :delete, turbo_confirm: t("common.confirm_delete") }, class: "Button Button--danger Button--small" do %>
              <i class="fas fa-trash"></i> <%= t("common.delete") %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @addresses.empty? %>
    <div class="Listing__empty">
      <div class="Listing__empty-icon"><i class="fas fa-location-dot"></i></div>
      <div class="Listing__empty-description"><%= t("addresses.no_addresses") %></div>
    </div>
  <% end %>
</div>
