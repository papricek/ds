<div class="Tabs mb-2" style="margin-top: -0.5rem;">
  <nav class="nav-tabs-secondary">
    <%= link_to manager_user_profile_path(@user), class: "nav-link #{'active' if active_tab == 'profile'}" do %>
      <i class="fas fa-user"></i> <%= @user.name %>
    <% end %>
    <%= link_to manager_user_details_path(@user), class: "nav-link #{'active' if active_tab == 'details'}" do %>
      <i class="fas fa-pen-to-square"></i> <%= t("manager.user_tabs.details") %>
    <% end %>
    <%= link_to manager_user_addresses_path(@user), class: "nav-link #{'active' if active_tab == 'addresses'}" do %>
      <i class="fas fa-location-dot"></i> <%= t("manager.user_tabs.addresses") %>
    <% end %>
    <%= link_to manager_user_user_sharings_path(@user), class: "nav-link #{'active' if active_tab == 'sharings'}" do %>
      <i class="fas fa-share-nodes"></i> <%= t("manager.user_tabs.sharings") %>
    <% end %>
    <%= link_to manager_user_user_billings_path(@user), class: "nav-link #{'active' if active_tab == 'billings'}" do %>
      <i class="fas fa-file-invoice"></i> <%= t("manager.user_tabs.billings") %>
    <% end %>
    <%= link_to manager_user_user_settings_path(@user), class: "nav-link #{'active' if active_tab == 'settings'}" do %>
      <i class="fas fa-gear"></i> <%= t("manager.user_tabs.settings") %>
    <% end %>
  </nav>
</div>
