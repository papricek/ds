<% content_for :title, t("navigation.users") %>

<%= render "manager/shared/navigation" %>

<div class="d-flex justify-content-end mb-3">
  <%= link_to new_manager_user_path, class: "Button Button--primary" do %>
    <i class="fas fa-plus me-1"></i> <%= t("common.create") %>
  <% end %>
</div>

<div class="Listing Listing--responsive">
  <% @users.each do |user| %>
    <div class="Listing__item">
      <div class="Listing__content Listing__content--single-line">
        <div class="Listing__main">
          <div class="Listing__status Listing__status--<%= user.manager? ? 'admin' : 'user' %>">
            <i class="fas <%= user.manager? ? 'fa-shield-halved' : 'fa-user' %>"></i>
          </div>
          <div class="Listing__info">
            <div class="Listing__info-primary">
              <%= link_to user.name, manager_user_profile_path(user) %>
              <span class="Listing__badge Listing__badge--<%= user.manager? ? 'info' : 'secondary' %>">
                <%= t("users.roles.#{user.role}") %>
              </span>
            </div>
            <div class="Listing__info-secondary"><%= user.email %></div>
          </div>
        </div>
        <div class="Listing__actions">
          <% if user != Current.user %>
            <%= link_to manager_impersonate_user_path(id: user), data: { turbo_method: :patch }, class: "Button Button--secondary Button--small", title: t("manager.impersonate.action") do %>
              <i class="fas fa-user-secret"></i>
            <% end %>
          <% end %>
          <%= link_to manager_user_details_path(user), class: "Button Button--secondary Button--small" do %>
            <i class="fas fa-pen"></i> <%= t("common.edit") %>
          <% end %>
          <%= link_to manager_user_path(user), data: { turbo_method: :delete, turbo_confirm: t("common.confirm_delete") }, class: "Button Button--danger Button--small" do %>
            <i class="fas fa-trash"></i> <%= t("common.delete") %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if @users.respond_to?(:total_pages) && @users.total_pages > 1 %>
  <div class="Listing__pagination">
    <%= paginate @users, theme: "bootstrap-5" %>
  </div>
<% end %>
