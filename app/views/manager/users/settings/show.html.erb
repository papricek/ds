<% content_for :title, @user.name %>

<%= render "manager/shared/navigation" %>
<%= render "manager/users/tab_navigation", active_tab: "settings" %>

<div class="mt-3">
  <% if @user != Current.user %>
    <div class="Card" style="border: 1px solid var(--danger-color);">
      <div class="Card__title" style="color: var(--danger-color);">
        <i class="fas fa-triangle-exclamation me-2"></i><%= t("manager.user_settings.danger_zone") %>
      </div>
      <div class="p-3">
        <p style="color: var(--white-7);"><%= t("manager.user_settings.destroy_warning", name: @user.name) %></p>
        <%= link_to manager_user_path(@user), data: { turbo_method: :delete, turbo_confirm: t("manager.user_settings.destroy_confirm", name: @user.name) }, class: "Button Button--danger" do %>
          <i class="fas fa-trash me-2"></i><%= t("manager.user_settings.destroy_button") %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
