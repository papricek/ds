<% content_for :title, @user.name %>

<%= render "manager/shared/navigation" %>
<%= render "manager/users/tab_navigation", active_tab: "details" %>

<div class="mt-3">
  <div class="Card">
    <%= form_with(model: @user, url: manager_user_details_path(@user), method: :patch, class: "Form Form--dark", html: { novalidate: true }) do |f| %>
      <div class="row">
        <div class="col-md-6">
          <div class="form-floating Form__group">
            <%= f.text_field :name, class: "form-control Form__input #{error_class_for(@user, :name)}", placeholder: t("users.name") %>
            <%= f.label :name, t("users.name"), class: "Form__label Form__label--required" %>
            <%= error_message_for(@user, :name) %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-floating Form__group">
            <%= f.email_field :email, class: "form-control Form__input #{error_class_for(@user, :email)}", placeholder: t("users.email") %>
            <%= f.label :email, t("users.email"), class: "Form__label Form__label--required" %>
            <%= error_message_for(@user, :email) %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="form-floating Form__group">
            <%= f.text_field :phone, class: "form-control Form__input #{error_class_for(@user, :phone)}", placeholder: t("users.phone") %>
            <%= f.label :phone, t("users.phone"), class: "Form__label" %>
            <%= error_message_for(@user, :phone) %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-floating Form__group">
            <%= f.select :role, [
              [t("users.roles.user"), "user"],
              [t("users.roles.manager"), "manager"]
            ], {}, class: "form-select Form__input" %>
            <%= f.label :role, t("users.role"), class: "Form__label" %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="form-floating Form__group">
            <%= f.password_field :password, class: "form-control Form__input #{error_class_for(@user, :password)}", placeholder: t("users.password"), autocomplete: "new-password" %>
            <%= f.label :password, t("users.password"), class: "Form__label" %>
            <%= error_message_for(@user, :password) %>
            <small style="color: var(--white-5);"><%= t("users.leave_blank_to_keep") %></small>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-floating Form__group">
            <%= f.password_field :password_confirmation, class: "form-control Form__input", placeholder: t("users.password_confirmation"), autocomplete: "new-password" %>
            <%= f.label :password_confirmation, t("users.password_confirmation"), class: "Form__label" %>
          </div>
        </div>
      </div>

      <div class="Form__actions">
        <%= link_to t("common.cancel"), manager_user_profile_path(@user), class: "Form__btn-link" %>
        <%= f.submit t("common.save"), class: "Form__btn", data: { disable_with: disable_with } %>
      </div>
    <% end %>
  </div>
</div>
