<% content_for :title, @user.name %>

<%= render "manager/shared/navigation" %>
<%= render "manager/users/tab_navigation", active_tab: "profile" %>

<div class="row mt-3">
  <div class="col-lg-4 mb-4">
    <div class="Card">
      <div class="p-3">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div class="Listing__status Listing__status--<%= @user.admin? ? 'admin' : 'user' %>" style="width: 3.5rem; height: 3.5rem; font-size: 1.5rem;">
            <i class="fas <%= @user.admin? ? 'fa-shield-halved' : 'fa-user' %>"></i>
          </div>
          <div>
            <div style="color: var(--neutral-white); font-weight: 600; font-size: 1.1rem;"><%= @user.name %></div>
            <div style="color: var(--white-5); font-size: 0.875rem;"><%= @user.email %></div>
          </div>
        </div>

        <div style="border-top: 1px solid var(--white-1); padding-top: 0.75rem;">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span style="color: var(--white-5); font-size: 0.9375rem;"><%= t("users.email") %></span>
            <span style="color: var(--neutral-white); font-size: 0.9375rem;"><%= copyable_field(@user.email) %></span>
          </div>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span style="color: var(--white-5); font-size: 0.9375rem;"><%= t("users.phone") %></span>
            <span style="color: var(--neutral-white); font-size: 0.9375rem;"><%= @user.phone.presence || "—" %></span>
          </div>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span style="color: var(--white-5); font-size: 0.9375rem;"><%= t("users.role") %></span>
            <span class="Listing__badge Listing__badge--<%= @user.admin? ? 'info' : 'secondary' %>"><%= t("users.roles.#{@user.role}") %></span>
          </div>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span style="color: var(--white-5); font-size: 0.9375rem;"><%= t("manager.user_tabs.addresses") %></span>
            <span style="color: var(--neutral-white); font-size: 0.9375rem;"><%= @user.addresses.count %> EAN</span>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <span style="color: var(--white-5); font-size: 0.9375rem;"><%= t("navigation.billings") %></span>
            <span style="color: var(--neutral-white); font-size: 0.9375rem;"><%= @user.billings.count %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-8 mb-4">
    <div class="Card">
      <div class="p-3">
        <% [
          { key: :yesterday, suffix: t("manager.user_stats.yesterday_suffix") },
          { key: :week, suffix: t("manager.user_stats.week_suffix") },
          { key: :year, suffix: t("manager.user_stats.year_suffix") }
        ].each_with_index do |period, idx| %>
          <div class="StatCardGrid<%= ' mt-3' unless idx.zero? %>">
            <div class="StatCard StatCard--compact StatCard--border-success" style="background: var(--white-05, rgba(255,255,255,0.05));">
              <div class="StatCard__icon" style="background-color: var(--semantic-success);">
                <i class="fas fa-solar-panel"></i>
              </div>
              <div class="StatCard__content">
                <div class="StatCard__label"><%= t("dashboards.production") %> <%= period[:suffix] %></div>
                <div class="StatCard__value"><%= @stats[period[:key]][:production] %> <span class="StatCard__unit">kWh</span></div>
              </div>
            </div>
            <div class="StatCard StatCard--compact StatCard--border-warning" style="background: var(--white-05, rgba(255,255,255,0.05));">
              <div class="StatCard__icon" style="background-color: var(--semantic-warning);">
                <i class="fas fa-bolt"></i>
              </div>
              <div class="StatCard__content">
                <div class="StatCard__label"><%= t("dashboards.consumption") %> <%= period[:suffix] %></div>
                <div class="StatCard__value"><%= @stats[period[:key]][:consumption] %> <span class="StatCard__unit">kWh</span></div>
              </div>
            </div>
            <div class="StatCard StatCard--compact StatCard--border-info" style="background: var(--white-05, rgba(255,255,255,0.05));">
              <div class="StatCard__icon" style="background-color: var(--semantic-info);">
                <i class="fas fa-share-nodes"></i>
              </div>
              <div class="StatCard__content">
                <div class="StatCard__label"><%= t("dashboards.sharing") %> <%= period[:suffix] %></div>
                <div class="StatCard__value"><%= @stats[period[:key]][:sharing] %> <span class="StatCard__unit">kWh</span></div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
