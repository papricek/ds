<% content_for :title, @user.name %>

<%= render "manager/shared/navigation" %>
<%= render "manager/users/tab_navigation", active_tab: "profile" %>

<div class="row mt-3">
  <div class="col-lg-4 mb-4">
    <div class="Card">
      <div class="p-3">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div class="Listing__status Listing__status--<%= @user.manager? ? 'admin' : 'user' %>" style="width: 3.5rem; height: 3.5rem; font-size: 1.5rem;">
            <i class="fas <%= @user.manager? ? 'fa-shield-halved' : 'fa-user' %>"></i>
          </div>
          <div>
            <div style="color: var(--neutral-white); font-weight: 600; font-size: 1.1rem;"><%= @user.name %></div>
            <div style="color: var(--white-5); font-size: 0.875rem;"><%= @user.email %></div>
          </div>
        </div>

        <div style="border-top: 1px solid var(--white-1); padding-top: 0.75rem;">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span style="color: var(--white-5); font-size: 0.8125rem;"><%= t("users.email") %></span>
            <span style="color: var(--neutral-white); font-size: 0.8125rem;"><%= copyable_field(@user.email) %></span>
          </div>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span style="color: var(--white-5); font-size: 0.8125rem;"><%= t("users.phone") %></span>
            <span style="color: var(--neutral-white); font-size: 0.8125rem;"><%= @user.phone.presence || "—" %></span>
          </div>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span style="color: var(--white-5); font-size: 0.8125rem;"><%= t("users.role") %></span>
            <span class="Listing__badge Listing__badge--<%= @user.manager? ? 'info' : 'secondary' %>"><%= t("users.roles.#{@user.role}") %></span>
          </div>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span style="color: var(--white-5); font-size: 0.8125rem;"><%= t("manager.user_tabs.addresses") %></span>
            <span style="color: var(--neutral-white); font-size: 0.8125rem;"><%= @user.addresses.count %> EAN</span>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <span style="color: var(--white-5); font-size: 0.8125rem;"><%= t("navigation.billings") %></span>
            <span style="color: var(--neutral-white); font-size: 0.8125rem;"><%= @user.billings.count %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-8 mb-4">
    <% [
      { key: :yesterday, label: t("manager.user_stats.yesterday"), icon_period: "fa-clock" },
      { key: :week, label: t("manager.user_stats.week"), icon_period: "fa-calendar-week" },
      { key: :year, label: t("manager.user_stats.year"), icon_period: "fa-calendar" }
    ].each do |period| %>
      <div class="mb-3">
        <div style="color: var(--white-5); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;">
          <i class="fas <%= period[:icon_period] %> me-1"></i> <%= period[:label] %>
        </div>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem;">
          <div class="StatCard StatCard--compact StatCard--border-success">
            <div class="StatCard__icon" style="background-color: var(--semantic-success);">
              <i class="fas fa-solar-panel"></i>
            </div>
            <div class="StatCard__content">
              <div class="StatCard__label"><%= t("dashboards.production") %></div>
              <div class="StatCard__value"><%= @stats[period[:key]][:production] %> <span class="StatCard__unit">kWh</span></div>
            </div>
          </div>
          <div class="StatCard StatCard--compact StatCard--border-warning">
            <div class="StatCard__icon" style="background-color: var(--semantic-warning);">
              <i class="fas fa-bolt"></i>
            </div>
            <div class="StatCard__content">
              <div class="StatCard__label"><%= t("dashboards.consumption") %></div>
              <div class="StatCard__value"><%= @stats[period[:key]][:consumption] %> <span class="StatCard__unit">kWh</span></div>
            </div>
          </div>
          <div class="StatCard StatCard--compact StatCard--border-info">
            <div class="StatCard__icon" style="background-color: var(--semantic-info);">
              <i class="fas fa-share-nodes"></i>
            </div>
            <div class="StatCard__content">
              <div class="StatCard__label"><%= t("dashboards.sharing") %></div>
              <div class="StatCard__value"><%= @stats[period[:key]][:sharing] %> <span class="StatCard__unit">kWh</span></div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
