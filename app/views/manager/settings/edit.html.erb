<% content_for :title, t("navigation.settings") %>

<%= render "manager/shared/navigation" %>

<div class="Card mb-4">
  <div class="Card__title"><%= t("settings.account_settings") %></div>
  <%= form_with(model: @account, url: manager_settings_path, method: :patch, class: "Form Form--dark") do |f| %>
    <div class="row">
      <div class="col-md-6">
        <div class="Form__group">
          <%= f.label :name, t("settings.account_name"), class: "Form__label Form__label--required" %>
          <%= f.text_field :name, class: "Form__input form-control #{error_class_for(@account, :name)}" %>
          <%= error_message_for(@account, :name) %>
        </div>
      </div>
      <div class="col-md-6">
        <div class="Form__group">
          <%= f.label :logo, t("settings.logo"), class: "Form__label" %>
          <%= f.file_field :logo, class: "Form__input form-control", accept: "image/*" %>
          <% if @account.logo.attached? %>
            <div class="mt-2">
              <%= image_tag @account.logo, style: "max-height: 40px;" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="d-flex gap-2 mt-3">
      <%= f.submit t("common.save"), class: "Button Button--primary", data: { disable_with: disable_with } %>
    </div>
  <% end %>
</div>

<div class="Card mb-4">
  <div class="Card__title"><%= t("settings.billing_settings") %></div>
  <%= form_with(model: @account, url: manager_settings_path, method: :patch, class: "Form Form--dark") do |f| %>
    <div class="row">
      <div class="col-md-3">
        <div class="Form__group">
          <%= f.label :settings_issue_day_in_month, t("settings.issue_day"), class: "Form__label" %>
          <%= f.number_field :settings_issue_day_in_month, class: "Form__input form-control", min: 1, max: 28 %>
        </div>
      </div>
      <div class="col-md-3">
        <div class="Form__group">
          <%= f.label :settings_supply_day_in_month, t("settings.supply_day"), class: "Form__label" %>
          <%= f.number_field :settings_supply_day_in_month, class: "Form__input form-control", min: 1, max: 28 %>
        </div>
      </div>
      <div class="col-md-3">
        <div class="Form__group">
          <%= f.label :settings_due_days, t("settings.due_days"), class: "Form__label" %>
          <%= f.number_field :settings_due_days, class: "Form__input form-control", min: 1, max: 90 %>
        </div>
      </div>
      <div class="col-md-3">
        <div class="Form__group">
          <%= f.label :settings_billing_copy_email, t("settings.billing_copy_email"), class: "Form__label" %>
          <%= f.email_field :settings_billing_copy_email, class: "Form__input form-control" %>
        </div>
      </div>
    </div>

    <div class="d-flex gap-2 mt-3">
      <%= f.submit t("common.save"), class: "Button Button--primary", data: { disable_with: disable_with } %>
    </div>
  <% end %>
</div>

<div class="Card">
  <div class="Card__title"><%= t("settings.edc_sync") %></div>
  <div class="Box">
    <div class="Box__items">
      <div class="Box__item">
        <div class="Box__item-icon"><i class="fas fa-sync"></i></div>
        <div class="Box__item-main">
          <div class="Box__item-label"><%= t("settings.last_sync") %></div>
          <div class="Box__item-value">
            <% last_sync = Edc::Share.where(from_ean: Current.account.addresses.pluck(:ean)).maximum(:created_at) %>
            <% if last_sync %>
              <span class="Badge Badge--success"><%= l(last_sync, format: :default) %></span>
            <% else %>
              <span class="Badge Badge--neutral"><%= t("settings.never_synced") %></span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
