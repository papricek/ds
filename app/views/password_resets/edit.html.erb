<% content_for :title, t("password_resets.reset_password") %>

<%= render "layouts/session" do %>
  <h2 class="Sessions__title"><%= t("password_resets.reset_password") %></h2>

  <%= form_tag password_reset_path(params[:id]), method: :patch, html: { class: "Form" } do %>
    <div class="Form__group form-floating">
      <%= password_field_tag :password, "", class: "Form__input form-control", placeholder: t("password_resets.new_password") %>
      <%= label_tag :password, t("password_resets.new_password"), class: "Form__label" %>
    </div>
    <div class="Form__group form-floating">
      <%= password_field_tag :password_confirmation, "", class: "Form__input form-control", placeholder: t("password_resets.confirm_password") %>
      <%= label_tag :password_confirmation, t("password_resets.confirm_password"), class: "Form__label" %>
    </div>
    <div class="Sessions__submit">
      <%= submit_tag t("password_resets.reset_password"), class: "Button Button--primary", style: "width: 100%; padding: 0.75rem; font-size: 1.1rem; border-radius: 50px;" %>
    </div>
  <% end %>
<% end %>
