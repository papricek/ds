<% content_for :title, t("password_resets.title") %>

<%= render "layouts/session" do %>
  <h2 class="Sessions__title"><%= t("password_resets.title") %></h2>

  <%= form_tag password_resets_path, html: { class: "Form" } do %>
    <div class="Form__group form-floating">
      <%= text_field_tag :email, params[:email], class: "Form__input form-control", placeholder: t("sessions.email"), autofocus: true %>
      <%= label_tag :email, t("sessions.email"), class: "Form__label" %>
    </div>
    <div class="Sessions__submit">
      <%= submit_tag t("password_resets.send_link"), class: "Button Button--primary", style: "width: 100%; padding: 0.75rem; font-size: 1.1rem; border-radius: 50px;" %>
    </div>
    <div class="Sessions__text mt-3 text-center">
      <%= link_to t("common.back"), new_session_path %>
    </div>
  <% end %>
<% end %>
