<% content_for :title, t("sessions.title") %>

<%= render "layouts/session" do %>
  <h2 class="Sessions__title"><%= t("sessions.title") %></h2>

  <%= form_tag session_path, html: { class: "Form" } do %>
    <div class="Form__group form-floating">
      <%= text_field_tag :email, params[:email], class: "Form__input form-control", placeholder: t("sessions.email"), autofocus: true %>
      <%= label_tag :email, t("sessions.email"), class: "Form__label" %>
    </div>
    <div class="Form__group form-floating">
      <%= password_field_tag :password, "", class: "Form__input form-control", placeholder: t("sessions.password") %>
      <%= label_tag :password, t("sessions.password"), class: "Form__label" %>
    </div>
    <div class="Sessions__actions">
      <div></div>
      <div class="Sessions__text">
        <%= link_to t("sessions.forgot_password"), new_password_reset_path %>
      </div>
    </div>
    <div class="Sessions__submit">
      <%= submit_tag t("sessions.login"), class: "Button Button--primary", style: "width: 100%; padding: 0.75rem; font-size: 1.1rem; border-radius: 50px;" %>
    </div>
  <% end %>
<% end %>
