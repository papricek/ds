<% content_for :title, "Přihlášení" %>

<%= render "layouts/session" do %>
  <h2 class="Sessions__title">Přihlášení</h2>

  <%= form_tag session_path, class: "Form" do %>
    <div class="Form__group form-floating">
      <%= text_field_tag :email, params[:email], class: "Form__input form-control", placeholder: "E-mail", autofocus: true %>
      <%= label_tag :email, "E-mail", class: "Form__label" %>
    </div>

    <div class="Form__group form-floating" data-controller="password-toggle">
      <%= password_field_tag :password, "", class: "Form__input form-control", placeholder: "Heslo", data: { password_toggle_target: "input" } %>
      <%= label_tag :password, "Heslo", class: "Form__label" %>
    </div>

    <div class="Sessions__password-actions d-flex justify-content-between align-items-center">
      <%= link_to "Zapomenuté heslo?", new_password_reset_path, class: "Sessions__text Sessions__text--without-margin" %>
    </div>

    <div class="Sessions__submit mt-4">
      <%= submit_tag "Přihlásit se", class: "Btn__cta Btn__cta--large w-100" %>
    </div>
  <% end %>
<% end %>
